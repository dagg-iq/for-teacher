{
  "hosting": {
    "public": "hosting",
    "cleanUrls": true,
    "headers": [
      { "source": "**", "headers": [ { "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" } ] },
      { "source": "**/*.@(woff2|webp|png)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=2592000" } ] },
      { "source": "**/*.@(html|css|js|json)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "/admin/**", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "X-Frame-Options", "value": "DENY" }, { "key": "Cache-Control", "value": "no-store" } ] }
    ]
  }
}
