{
  "expo": {
    "name": "مِداد",
    "slug": "midad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "midad",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F5F2",
    "ios": {
      "bundleIdentifier": "app.midad.teacher",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "يحتاج مِداد الميكروفون لإدخال الدرجات بالصوت.",
        "NSSpeechRecognitionUsageDescription": "يحتاج مِداد التعرّف على الكلام لفهم أسماء الطلاب والدرجات."
      }
    },
    "android": {
      "package": "app.midad.teacher",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110,
          "dark": {
            "backgroundColor": "#0E0E0F",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4338F0"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "يحتاج مِداد الميكروفون لإدخال الدرجات بالصوت.",
          "speechRecognitionPermission": "يحتاج مِداد التعرّف على الكلام لفهم أسماء الطلاب والدرجات.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.tts"]
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    }
  }
}
