{
  "expo": {
    "name": "نَهج",
    "slug": "nahj",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nahj",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F5F0",
    "ios": {
      "bundleIdentifier": "app.nahj.teacher",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "يحتاج نَهج الميكروفون لإدخال الدرجات بالصوت.",
        "NSSpeechRecognitionUsageDescription": "يحتاج نَهج التعرّف على الكلام لفهم أسماء الطلاب والدرجات."
      }
    },
    "android": {
      "package": "app.nahj.teacher",
      "adaptiveIcon": {
        "backgroundColor": "#0E3B33",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0B6E5E"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "يحتاج نَهج الميكروفون لإدخال الدرجات بالصوت.",
          "speechRecognitionPermission": "يحتاج نَهج التعرّف على الكلام لفهم أسماء الطلاب والدرجات.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      "expo-font",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/thmanyahsans-Regular.otf",
            "./assets/fonts/thmanyahsans-Bold.otf",
            "./assets/fonts/thmanyahserifdisplay-Black.otf"
          ],
          "widgets": [
            {
              "name": "Today",
              "label": "حصص اليوم",
              "description": "حصصك اليوم والحصة الحالية والقادمة",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "maxResizeHeight": "400dp"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    }
  }
}